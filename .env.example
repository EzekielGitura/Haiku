# Server-side only; set these as secrets in your hosting dashboard.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
GROQ_API_KEY=your-groq-api-key
# Optional; defaults to openai/gpt-oss-120b (hosted by GroqCloud).
GROQ_MODEL=openai/gpt-oss-120b
# Optional: enables the protected /api/daily-poem scheduler endpoint.
CRON_SECRET=choose-a-long-random-secret
# Optional: used only by database migration tooling.
DATABASE_URL=postgresql://user:password@host:5432/postgres
